__pycache__/
*.pyc
*.pyo

# Models (too large for git)
*.pt
*.onnx
*.engine
*.bak
models/

# Archives & dataset bundles (never commit — pushed to Kaggle/Drive instead)
*.zip
*.tar
*.tar.gz
*.npz

# Extracted dataset folders at repo root (local work artifacts)
/Final Project-fine-tunning_dataset/
/*_dataset/

# Data (videos, images, crops). Use data/* (not data/) so we can re-include
# the wet_floor scaffolding directories via .gitkeep markers below.
data/*

# Wet floor: track directory skeleton but ignore raw videos, frames,
# and curated images.
!data/wet_floor/
data/wet_floor/*
!data/wet_floor/raw_videos/
!data/wet_floor/frames_session1/
!data/wet_floor/curated/
!data/wet_floor/public/
data/wet_floor/raw_videos/*
data/wet_floor/frames_session1/*
data/wet_floor/curated/*
data/wet_floor/public/*
!data/wet_floor/curated/positives/
!data/wet_floor/curated/negatives/
!data/wet_floor/curated/holdout_test/
data/wet_floor/curated/positives/*
data/wet_floor/curated/negatives/*
data/wet_floor/curated/holdout_test/*
!data/wet_floor/**/.gitkeep

# Test artifacts
tests/test_frame.jpg
.pytest_cache/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Environment
.env
venv/
.venv/

# Claude Code local tool config (machine-specific, may contain local paths/creds)
.claude/

# Unrelated personal/academic files — do not track at repo root
*.docx
*.pptx
comp4200.tex

# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Live camera stream (keeps RTSP credentials out of source control).
# Leave unset to use the bundled sample video in data/sample_videos/.
# CAMERA_RTSP_URL=rtsp://user:password@host:554/stream

# Backend base URL. PPE and zone alert endpoints are derived from this.
# Defaults to http://localhost:8080 if unset.
# BACKEND_URL=http://your-backend-host:8080

# Optional: override individual endpoints if they don't share BACKEND_URL.
# PPE_ALERTS_ENDPOINT=http://your-backend-host:8080/api/ppe-alerts/create
# ZONES_ENDPOINT=http://your-backend-host:8080/api/zones
